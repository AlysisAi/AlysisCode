            "name": "help",
            "description": "Show Alysis Code help and open the conversation."
          },
          {
            "name": "forge",
            "description": "Create a reviewable Forge plan for a task."
          },
          {
            "name": "execute",
            "description": "Open Alysis Code and review a plan before execution."
          },
          {
            "name": "doctor",
            "description": "Open Alysis Code and check the local setup."
          }
        ]
      }
    ],
