    "configuration": {
      "title": "Alysis Code",
      "properties": {
        "alysis.extraCaCerts": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "Absolute path to a PEM bundle of additional certificate authorities (for example a corporate TLS-inspecting proxy's CA). The CLI trusts these **in addition to** its bundled roots, and Node-based MCP servers receive it as `NODE_EXTRA_CA_CERTS`. VS Code's `http.proxy`, `http.noProxy` and `http.proxySupport` are forwarded to the CLI automatically; `http.proxyStrictSSL: false` is deliberately not honoured — add the CA here instead."
        },
        "alysis.cliPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "Development-only override for the `alysis` executable. Leave empty to use the signed, extension-managed runtime. Explicit paths are not managed or release-verified and are shown as non-production in Runtime Details."
        },
        "alysis.defaultMode": {
          "type": "string",
          "default": "review",
          "enum": [
            "readonly",
            "review",
            "auto"
          ],
          "enumDescriptions": [
            "Read-only: inspect and explain without changing files.",
            "Review: ask before important changes.",
            "Auto: work independently within Alysis Code safeguards. Forge plan execution still runs in review mode and refuses to start in Auto."
          ],
          "markdownDescription": "Choose how much independence Alysis Code has when starting a task. Forge plan execution (`Alysis Code: Review and Run Plan`) supports review mode only — set this to `review` before running a plan."
        },
        "alysis.defaultModel": {
          "type": "string",
          "default": "",
          "description": "Optional default model name passed to the Alysis Code IDE bridge. Configure the router model through Alysis Code: Configure Provider or CLI role_models.router.",
          "scope": "machine-overridable"
        },
        "alysis.baseUrl": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "Optional base URL override for the configured provider. User settings only: a workspace cannot redirect where the stored API key is sent. Plain `http://` is accepted for loopback hosts only (Ollama, LM Studio); every other host must be `https://`. Credentials are never stored here — run **Alysis Code: Configure Provider** to save an API key in VS Code SecretStorage."
        },
        "alysis.provider": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "markdownDescription": "Provider label shown in Alysis Code UI. Run **Alysis Code: Models and Providers** to pick from the presets your CLI supports."
        },
        "alysis.transport": {
          "type": "string",
          "default": "stdio",
          "enum": [
            "stdio"
          ],
          "description": "Transport used by the extension to communicate with Alysis Code.",
          "enumDescriptions": [
            "Standard input/output. The only transport supported today."
          ]
        },
        "alysis.sandboxProfile": {
          "type": "string",
          "default": "default",
          "enum": [
            "default",
            "strict",
            "warn",
            "off"
          ],
          "enumDescriptions": [
            "Use the sandbox profile the CLI selects for this workspace.",
            "Request the CLI’s most restrictive sandbox profile.",
            "Request a permissive profile that warns instead of blocking.",
            "Request that sandboxing be disabled."
          ],
          "markdownDescription": "Requested sandbox profile for new chat, task and worktree sessions, and Forge execution. Start a new session after changing this setting. The CLI environment policy takes precedence; Forge requires strict isolation for mutations."
        },
        "alysis.forgeExecuteMaxSteps": {
          "type": "integer",
          "default": 0,
          "minimum": 0,
          "maximum": 1000,
          "markdownDescription": "Maximum number of plan steps a single Forge execution may run. Leave at `0` to use the CLI default."
        },
        "alysis.forgeExecuteNoLog": {
          "type": "boolean",
          "default": false,
          "description": "Pass no_log=true for IDE Forge Execute Review jobs. Structured protocol events and bounded artifacts still remain available."
        },
        "alysis.showStatusBar": {
          "type": "boolean",
          "default": true,
          "description": "Show the Alysis Code status bar item."
        },
        "alysis.autoStartBridge": {
          "type": "boolean",
          "default": false,
          "description": "Check the local engine's health as soon as the extension activates, instead of waiting for the first task. No task is ever started automatically."
        },
        "alysis.enableForge": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Show Alysis Code Forge planning and execution commands. Forge Plan and non-mutating Execute Preview run when the IDE bridge supports them; real execution stays fail-closed unless the backend supports safe execution, and trusted-workspace gates always apply."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "alysis",
          "title": "Alysis Code",
          "icon": "resources/alysis-logo.svg"
        }
      ]
    },
    "views": {
      "alysis": [
        {
          "id": "alysis.start",
          "name": "Alysis Code",
          "type": "webview",
          "visibility": "visible",
          "retainContextWhenHidden": true
        }
      ]
    },
    "menus": {
      "editor/context": [
        {
          "command": "alysis.addSelection",
          "when": "editorHasSelection",
          "group": "alysis@1"
        }
      ],
      "view/title": [
        {
          "command": "alysis.newSession",
          "when": "view == alysis.start",
          "group": "navigation@1"
        },
        {
          "command": "alysis.showForge",
          "when": "view == alysis.start",
          "group": "navigation@2"
        },
        {
          "command": "alysis.showBrowser",
          "when": "view == alysis.start",
          "group": "navigation@2.5"
        },
        {
          "command": "alysis.showHistory",
          "when": "view == alysis.start",
          "group": "navigation@3"
        },
        {
          "command": "alysis.configureProvider",
          "when": "view == alysis.start",
          "group": "navigation@5"
        },
        {
          "command": "alysis.showSettings",
          "when": "view == alysis.start",
          "group": "navigation@6"
        }
      ],
      "commandPalette": [
        {
          "command": "alysis.session.show",
          "when": "false"
        },
        {
          "command": "alysis.session.score",
          "when": "false"
        },
        {
          "command": "alysis.session.usage",
          "when": "false"
        },
        {
          "command": "alysis.session.compact",
          "when": "false"
        },
        {
          "command": "alysis.session.clear",
          "when": "false"
        },
        {
          "command": "alysis.session.resume",
          "when": "false"
        },
        {
          "command": "alysis.manage.info",
          "when": "false"
        },
        {
          "command": "alysis.manage.trust",
          "when": "false"
        },
        {
          "command": "alysis.manage.untrust",
          "when": "false"
        },
        {
          "command": "alysis.manage.enable",
          "when": "false"
        },
        {
          "command": "alysis.manage.disable",
          "when": "false"
        },
        {
          "command": "alysis.manage.remove",
          "when": "false"
        },
        {
          "command": "alysis.manage.mcpLogin",
          "when": "false"
        },
        {
          "command": "alysis.manage.mcpLogout",
          "when": "false"
        },
        {
          "command": "alysis.manage.refresh",
          "when": "false"
        }
      ]
    },
    "walkthroughs": [
      {
        "id": "alysis.gettingStarted",
        "title": "Get started with Alysis Code",
        "description": "Validate the bundled runtime, trust your workspace, configure a provider, and open Alysis Code.",
        "steps": [
          {
            "id": "installCli",
            "title": "Validate the managed Alysis Code runtime",
            "description": "Production builds bundle a signed runtime that the extension validates, installs, and rolls back automatically. A manual CLI path is available only as a development override.\n[Check connection](command:alysis.showBridgeHealth)\n[Open troubleshooting](command:alysis.healthDiagnostics)",
            "media": {
              "markdown": "media/walkthrough/install-cli.md"
            },
            "completionEvents": [
              "onCommand:alysis.showBridgeHealth"
            ]
          },
          {
            "id": "trustWorkspace",
            "title": "Trust this workspace",
            "description": "Untrusted workspaces keep Alysis Code read-only: no write-capable Forge runs and no workspace-local CLI.",
            "media": {
              "markdown": "media/walkthrough/trust-workspace.md"
            },
            "completionEvents": [
              "onContext:isWorkspaceTrusted"
            ]
          },
          {
            "id": "configureProvider",
            "title": "Configure a provider",
            "description": "Store your provider API key in VS Code SecretStorage — never in plaintext settings.\n[Configure Provider](command:alysis.configureProvider)",
            "media": {
              "markdown": "media/walkthrough/configure-provider.md"
            },
            "completionEvents": [
              "onCommand:alysis.configureProvider"
            ]
          },
          {
            "id": "openCockpit",
            "title": "Open Alysis Code",
            "description": "Chat, plan, and review work from one clear Alysis Code conversation.\n[Open Alysis Code](command:alysis.openChat)",
            "media": {
              "markdown": "media/walkthrough/open-cockpit.md"
            },
            "completionEvents": [
              "onCommand:alysis.openChat"
            ]
          }
        ]
      }
    ],
    "keybindings": [
      {
        "command": "alysis.openChat",
        "key": "ctrl+alt+s",
        "mac": "cmd+alt+s"
      },
      {
        "command": "alysis.addSelection",
        "key": "ctrl+alt+a",
        "mac": "cmd+alt+a",
        "when": "editorHasSelection"
      },
      {
        "command": "alysis.cancelCurrentRun",
        "key": "ctrl+alt+backspace",
        "mac": "cmd+alt+backspace",
        "when": "alysis.hasActiveJob"
      }
    ]
  },
  "capabilities": {
    "virtualWorkspaces": {
      "supported": false,
      "description": "Alysis Code requires local workspace file paths and a local executable CLI; virtual workspaces are not supported."
    },
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Bridge health, provider setup, doctor checks, readonly commands, and Forge Execute Preview are available when executable-origin guards pass. Forge execution and write-capable modes require Workspace Trust.",
      "restrictedConfigurations": [
        "alysis.cliPath",
        "alysis.defaultMode",
        "alysis.defaultModel",
        "alysis.baseUrl",
        "alysis.provider",
        "alysis.transport",
        "alysis.sandboxProfile",
        "alysis.forgeExecuteMaxSteps",
        "alysis.forgeExecuteNoLog",
        "alysis.autoStartBridge",
        "alysis.enableForge",
        "alysis.extraCaCerts"
      ]
    }
  },
  "devDependencies": {
    "@types/jsdom": "^28.0.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.11.30",
    "@types/vscode": "1.90.0",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.0.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.13.0",
    "glob": "13.0.6",
    "jsdom": "^29.1.1",
    "mocha": "^11.7.6",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.10.0"
  },
  "overrides": {
    "@azure/msal-node": "7.1.2",
    "brace-expansion": "5.0.12",
    "mocha": {
      "diff": "8.0.4",
      "serialize-javascript": "7.1.3"
    }
  },
  "extensionKind": [
    "workspace"
  ],
  "preview": false,
  "pricing": "Free",
  "homepage": "https://github.com/AlysisAi/AlysisCode",
  "bugs": {
    "url": "https://github.com/AlysisAi/AlysisCode/issues"
  },
