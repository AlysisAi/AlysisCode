{
  "name": "vscode-alysis",
  "displayName": "Alysis Code",
  "description": "A local-first VS Code agent for clear conversations, planning, and reviewed changes.",
  "version": "0.3.0",
  "publisher": "alysisai",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/AlysisAi/AlysisCode.git",
    "directory": "extensions/vscode-alysis"
  },
  "icon": "resources/icon.png",
  "keywords": [
    "alysis",
    "ai",
    "coding-agent",
    "developer-tools",
    "workspace",
    "local-first"
  ],
  "galleryBanner": {
    "color": "#0B1220",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "AI",
    "Chat",
    "Machine Learning"
  ],
  "activationEvents": [
    "onCommand:alysis.runtimeEvidence"
  ],
  "main": "./dist/extension.js",
  "scripts": {
    "clean": "node -e \"for (const dir of ['out', 'dist']) require('fs').rmSync(dir, { recursive: true, force: true, maxRetries: 5, retryDelay: 200 })\"",
    "compile": "npm run sync:ui && npm run clean && tsc -p ./ && npm run bundle",
    "compile:tsc": "npm run sync:ui && npm run clean && tsc -p ./",
    "bundle": "node scripts/bundle.js",
    "bundle:production": "node scripts/bundle.js --production",
    "vscode:prepublish": "npm run bundle:production",
    "watch": "tsc -watch -p ./",
    "watch:bundle": "node scripts/bundle.js --watch",
    "lint": "node scripts/sync-shared-ui.js --check && tsc -p ./ --noEmit && tsc -p ./tsconfig.webview.json && eslint .",
    "test": "npm run compile && node scripts/run-unit-tests.js",
    "test:integration": "npm run compile && node ./out/test/integration/runTest.js",
    "test:cursor": "npm run compile && node scripts/test-cursor.js",
    "test:perf-activation": "npm run compile && node ./out/test/integration/perf-activation/runTest.js",
    "test:production-install": "npm run compile && node ./out/test/integration/production/runTest.js",
    "test:installed-live-provider": "npm run compile && node ./out/test/integration/production-live-provider/runTest.js",
    "test:untrusted-production": "npm run compile && node ./out/test/integration/untrusted-production/runTest.js",
    "package": "npm run package:vsix",
    "package:vsix": "npm run compile && npm run bundle:production && node ./scripts/package-release.js",
    "package:pre-release": "npm run compile && npm run bundle:production && node ./scripts/package-release.js --pre-release",
    "prepublish:check": "npm run compile && npm run lint && npm test && npm audit --audit-level=high && npm run package:vsix",
    "publish:dry-run": "npm run prepublish:check && vsce ls --tree --no-dependencies",
    "package:dev-vsix": "npm run compile && npm run bundle:production && vsce package --no-dependencies --baseImagesUrl https://raw.githubusercontent.com/AlysisAi/AlysisCode/main/extensions/vscode-alysis",
    "sync:ui": "node scripts/sync-shared-ui.js"
  },
  "contributes": {
    "chatParticipants": [
